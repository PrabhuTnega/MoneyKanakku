# Copy to .env. DATABASE_URL is NOT duplicated here on purpose — the API
# imports the Prisma client straight from ../db, which loads its own .env
# (see src/lib/prisma.ts). This file only holds API-specific config.

PORT=4100
NODE_ENV=development

# Where the frontend is served from during local dev (the static HTML/CSS/JS
# in the project root, currently served via `python -m http.server 8080`).
CORS_ORIGIN=http://localhost:8080

# Number of reverse-proxy hops in front of this process (Express's
# `trust proxy`). 0 = none (correct for local dev / no proxy). In
# production behind nginx/Cloudflare/a PaaS load balancer, set this to the
# actual hop count (usually 1) — otherwise every request's IP collapses to
# the proxy's own address, which breaks per-user rate limiting (everyone
# shares one bucket) and makes audit-log IPs useless. Never set to a value
# that trusts an untrusted network — that lets a client spoof its own
# X-Forwarded-For and dodge rate limiting entirely.
TRUST_PROXY=0

# Access + refresh token cookies (FRS: session-based auth, access/refresh
# split — see api/README.md's "Access + refresh tokens" section).
# Access token: short-lived, stateless (self-signed, no DB lookup to verify
# it). Refresh token: long-lived, opaque, DB-tracked in the `sessions`
# table, and ROTATED on every use — that's what lets a user stay signed in
# indefinitely just by opening the app at least once every
# REFRESH_TOKEN_TTL_DAYS, without ever storing anything in localStorage.
ACCESS_COOKIE_NAME=expensio_at
REFRESH_COOKIE_NAME=expensio_rt
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be a long random string in any real deployment. Used both to sign
# the refresh cookie's value (cookie-parser's `signed: true`) and as the
# HMAC key for self-signing access tokens (see src/lib/access-token.ts) —
# never a substitute for the refresh token's own DB hash lookup.
COOKIE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Real SMTP for forgot-password reset-link emails (see src/lib/mail.ts).
# All optional — leave SMTP_HOST unset and the reset link is just logged to
# the console instead of emailed, which keeps local dev usable without a
# real inbox. Use a provider App Password here, never a real account
# password (Gmail: Google Account -> Security -> App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM="MoneyKanakku <CHANGE_ME@gmail.com>"
